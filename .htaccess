# KPAH website: pretty URLs, no directory listing, protect private files.
Options -Indexes -MultiViews
DirectoryIndex index.php
RewriteEngine On

# Only the stable /assets/js/*.js URL is public. Do not expose a second
# direct URL for the minified distribution (script consumers use an internal rewrite).
RewriteRule ^assets/js-dist(?:/|$) - [F,END,NC]

# Source maps/debug bundles must never be served from the public webroot.
# The original client JavaScript itself remains visible to the browser.
RewriteRule "\.(?:map|js\.map)$" - [F,END,NC]

# Stop accidental exposure of Git internals, logs, SQL dumps and diagnostics.
# Apache 2.4 / mod_rewrite; applies before public routes.
RewriteRule "(^|/)\.(?!well-known(?:/|$))" - [F,END,NC]
RewriteRule "(^|/)(?:app|config|tools|storage|includes|database|tests|docs|vendor|\.git|\.svn|\.hg|\.github)(?:/|$)" - [F,END,NC]
RewriteRule "(^|/)(?:check|phpinfo|info)\.php$" - [F,END,NC]
RewriteRule "(^|/)(?:composer\.(?:json|lock)|package(?:-lock)?\.json|yarn\.lock|pnpm-lock\.yaml|web\.config)$" - [F,END,NC]
RewriteRule "\.(?:sql(?:\.(?:gz|zip|bz2|7z|rar))?|sqlite(?:3)?|db|bak|backup|old|orig|save|swp|log|ini|conf|pem|key|p12|pfx|phps|inc)$" - [F,END,NC]
RewriteRule "(^|/)[^/]*(?:backup|dump|database)[^/]*\.(?:zip|rar|7z|tar|tgz|gz)$" - [F,END,NC]
# Database archives named by dates/versions must not be web-downloadable either.
RewriteRule "\.(?:zip|rar|7z|tar|tgz|gz|bz2|xz|zst)(?:\.(?:bak|old|backup))?$" - [F,END,NC]
# Reject PHP/source-looking backup suffixes (e.g. config.php.txt, db.php.save).
RewriteRule "(^|/)(?:config(?:\.[^/]*)?|\.env(?:\.[^/]*)?|[^/]+\.php)\.(?:txt|save|backup|bak|old|orig|swp)$" - [F,END,NC]
# Deny common accidental debug and test endpoints, including nested directories.
RewriteRule "(^|/)(?:debug|test-db|db-test|adminer|phpmyadmin|phpinfo|server-status)(?:\.[^/]*)?$" - [F,END,NC]

# Only index.php is executable from the public root. Files and directories in
# app/config/tools are denied above, including after an incremental deployment.
# Rewrite known and unknown requests through the allowlisted front controller.
RewriteRule ^index\.php$ - [END]
# Preserve existing ACME webroot verification files for certificate renewal.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^\.well-known/acme-challenge/[A-Za-z0-9_-]+$ - [END]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(?:robots\.txt|sitemap\.xml)$ - [END]
# A direct top-level browser navigation gets a display-only encrypted preview.
# Actual script requests (Sec-Fetch-Dest: script) and legacy requests remain
# executable. Fetch Metadata headers can be forged: this is presentation only.
RewriteCond %{REQUEST_METHOD} ^GET$ [NC]
RewriteCond %{HTTP:Sec-Fetch-Mode} ^navigate$ [NC]
RewriteCond %{HTTP:Sec-Fetch-Dest} ^document$ [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^assets/js/([A-Za-z0-9_-]+\.js)$ app/pages/js-navigation-preview.php?asset=$1 [END]

# Serve tested, minified JavaScript at the same URL when a compiled
# counterpart is deployed. Fall back to source if build has not been published.
# This is obfuscation, NOT encryption or an authorization boundary.
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{DOCUMENT_ROOT}/assets/js-dist/$1 -f
RewriteRule ^assets/js/([A-Za-z0-9_-]+\.js)$ assets/js-dist/$1 [END]

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^assets/.*\.(?:css|js|svg|png|jpe?g|gif|webp|ico|ttf|woff2?)$ - [END,NC]
# Game icon copies are read-only image assets. Never execute or download code/config from res/.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^res/icon/[0-9]+\.png$ - [END,NC]
RewriteRule ^res(?:/|$) - [F,END,NC]
RewriteRule ^ index.php [END,QSA]

# Do not expose environment files, credentials, backups, or database dumps.
<FilesMatch "(?i)^(?:\.env(?:\..*)?|\.htaccess|\.htpasswd|config(?:\..*)?\.php|.*\.(?:sql|sqlite|log|ini|bak|old|orig|swp|pem|key|p12|pfx))$">
    Require all denied
</FilesMatch>
<FilesMatch "(?i)^(?:\.gitignore|\.gitattributes|\.gitmodules|README(?:\..*)?|LICENSE(?:\..*)?)$">
    Require all denied
</FilesMatch>

# Apply static JS response protections even though these files bypass PHP.
<IfModule mod_headers.c>
  <FilesMatch "(?i)\.(?:js|mjs)$">
    Header always set X-Content-Type-Options "nosniff"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set Referrer-Policy "no-referrer"
  </FilesMatch>
</IfModule>
