# KPAH Web — URL sạch, ẩn đuôi .php
Options -MultiViews
DirectoryIndex index.php
RewriteEngine On

# Nếu dự án nằm trong thư mục con, Apache tự giữ phần đường dẫn thư mục.
# KHÔNG ghi đường dẫn ổ đĩa Windows (C:/xampp/htdocs) vào RewriteBase.

# Đổi URL .php cũ sang URL sạch khi truy cập bằng GET.
RewriteCond %{THE_REQUEST} \s/+(.*/)?(login|dang-nhap)\.php[?\s] [NC]
RewriteRule ^(login|dang-nhap)\.php$ dang-nhap [R=302,L,NE]
RewriteCond %{THE_REQUEST} \s/+(.*/)?(register|dang-ky)\.php[?\s] [NC]
RewriteRule ^(register|dang-ky)\.php$ dang-ky [R=302,L,NE]
RewriteCond %{THE_REQUEST} \s/+(.*/)?(home|tai-khoan)\.php[?\s] [NC]
RewriteRule ^(home|tai-khoan)\.php$ tai-khoan [R=302,L,NE]
RewriteCond %{THE_REQUEST} \s/+(.*/)?(forgot-password|quen-mat-khau)\.php[?\s] [NC]
RewriteRule ^(forgot-password|quen-mat-khau)\.php$ quen-mat-khau [R=302,L,NE]

# Chuẩn hóa URL: không dùng dấu / cuối ở các trang.
RewriteRule ^(dang-nhap|dang-ky|tai-khoan|quen-mat-khau)/$ $1 [R=302,L]

# URL sạch -> file PHP thật.
RewriteRule ^dang-nhap/?$ login.php [END,QSA]
RewriteRule ^dang-ky/?$ register.php [END,QSA]
RewriteRule ^tai-khoan/?$ home.php [END,QSA]
RewriteRule ^quen-mat-khau/?$ forgot-password.php [END,QSA]

# Trang gốc luôn chạy index.php; index.php tự chuyển sang dang-nhap
# (hoặc tai-khoan nếu đã đăng nhập).
RewriteRule ^$ index.php [END]

# Không can thiệp file/thư mục thật như assets, api, includes.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [END]

# Những PHP khác (API, captcha...) tiếp tục chạy trực tiếp.
