# KPAH web: URL sạch, không liệt kê thư mục.
Options -Indexes -MultiViews
DirectoryIndex index.php
RewriteEngine On

# Chỉ chặn file JavaScript nằm ngoài thư mục assets/js.
# JavaScript công khai mà giao diện cần tải vẫn được phép chạy.
RewriteRule ^(?!assets/js/).+\.js$ - [F,END,NC]

# Bảo vệ file chứa thông tin cấu hình/secret và file nội bộ.
<FilesMatch "(?i)^(?:\.env(?:\..*)?|\.htaccess|\.htpasswd|config\.register(?:\.local)?\.php|.*\.(?:sql|sqlite|log|ini|bak|old|orig|swp|pem|key|p12|pfx))$">
    Require all denied
</FilesMatch>
<FilesMatch "(?i)^(?:\.gitignore|\.gitattributes|\.gitmodules|README(?:\..*)?|LICENSE(?:\..*)?)$">
    Require all denied
</FilesMatch>

# Đưa URL cũ có đuôi PHP về URL sạch.
RewriteCond %{THE_REQUEST} \s/+(.*/)?login\.php[?\s] [NC]
RewriteRule ^login\.php$ dang-nhap [R=302,L,NE]
RewriteCond %{THE_REQUEST} \s/+(.*/)?register\.php[?\s] [NC]
RewriteRule ^register\.php$ dang-ky [R=302,L,NE]
RewriteCond %{THE_REQUEST} \s/+(.*/)?home\.php[?\s] [NC]
RewriteRule ^home\.php$ tai-khoan [R=302,L,NE]
RewriteCond %{THE_REQUEST} \s/+(.*/)?forgot-password\.php[?\s] [NC]
RewriteRule ^forgot-password\.php$ quen-mat-khau [R=302,L,NE]

RewriteRule ^(dang-nhap|dang-ky|tai-khoan|quen-mat-khau)/$ $1 [R=302,L]
RewriteRule ^dang-nhap/?$ login.php [END,QSA]
RewriteRule ^dang-ky/?$ register.php [END,QSA]
RewriteRule ^tai-khoan/?$ home.php [END,QSA]
RewriteRule ^quen-mat-khau/?$ forgot-password.php [END,QSA]
RewriteRule ^$ index.php [END]

# Cho phép các file/thư mục khác chạy bình thường.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [END]
