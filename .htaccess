# KPAH web hardening rules (Apache 2.4+; merge carefully if the host already has rules).
Options -Indexes

# Never expose dotfiles, repository metadata, environment files or server-side backups.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule (^|/)\. - [F,L]
</IfModule>

<FilesMatch "(?i)^(\.env.*|\.gitignore|\.htaccess|\.htpasswd|.*\.(sql|log|ini|ya?ml|dist|bak|backup|old|orig|swp|tmp|dump|zip|tar|gz|7z|md))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Configurations, diagnostics and non-public implementation files must never be fetched directly.
<FilesMatch "(?i)^(config\.php|config\.register(\.local|\.local\.sample|\.sample)?\.php|check\.php|captcha\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Explicitly block sensitive/internal directories even if their own .htaccess is missing.
RewriteRule ^(includes|storage|database|\.git)(/|$) - [F,L,NC]

# Do not disable PHP or static assets globally: registration APIs and browser JS/CSS must remain reachable.
