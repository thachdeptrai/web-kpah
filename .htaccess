# KPAH web: không liệt kê thư mục.
Options -Indexes -MultiViews
DirectoryIndex index.php
RewriteEngine On

# Chỉ chặn file JavaScript nằm ngoài assets/js.
RewriteRule ^(?!assets/js/).+\.js$ - [F,END,NC]

# Bảo vệ file cấu hình/secret và dữ liệu nội bộ.
<FilesMatch "(?i)^(?:\.env(?:\..*)?|\.htaccess|\.htpasswd|config\.register(?:\.local)?\.php|.*\.(?:sql|sqlite|log|ini|bak|old|orig|swp|pem|key|p12|pfx))$">
    Require all denied
</FilesMatch>
<FilesMatch "(?i)^(?:\.gitignore|\.gitattributes|\.gitmodules|README(?:\..*)?|LICENSE(?:\..*)?)$">
    Require all denied
</FilesMatch>

# Chuyển URL ngắn sang URL file PHP tương ứng.
RewriteRule ^dang-nhap/?$ login.php [R=302,L,NE]
RewriteRule ^dang-ky/?$ register.php [R=302,L,NE]
RewriteRule ^tai-khoan/?$ home.php [R=302,L,NE]
RewriteRule ^quen-mat-khau/?$ forgot-password.php [R=302,L,NE]

# Trang chủ.
RewriteRule ^$ index.php [END]

# Cho phép file/thư mục khác chạy bình thường.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [END]
