# KPAH website: pretty URLs, no directory listing, protect private files.
Options -Indexes -MultiViews
DirectoryIndex index.php
RewriteEngine On

# Stop accidental exposure of Git internals, logs, SQL dumps and diagnostics.
# Apache 2.4 / mod_rewrite; applies before public routes.
RewriteRule "(^|/)\.(?!well-known(?:/|$))" - [F,END,NC]
RewriteRule "(^|/)(?:app|tools|storage|includes|database|tests|docs|vendor|\.git|\.svn|\.hg|\.github)(?:/|$)" - [F,END,NC]
RewriteRule "(^|/)(?:check|phpinfo|info)\.php$" - [F,END,NC]
RewriteRule "(^|/)(?:composer\.(?:json|lock)|package(?:-lock)?\.json|yarn\.lock|pnpm-lock\.yaml|web\.config)$" - [F,END,NC]
RewriteRule "\.(?:sql(?:\.(?:gz|zip|bz2|7z|rar))?|sqlite(?:3)?|db|bak|backup|old|orig|save|swp|log|ini|conf|pem|key|p12|pfx|phps|inc)$" - [F,END,NC]
RewriteRule "(^|/)[^/]*(?:backup|dump|database)[^/]*\.(?:zip|rar|7z|tar|tgz|gz)$" - [F,END,NC]
# Database archives named by dates/versions must not be web-downloadable either.
RewriteRule "\.(?:zip|rar|7z|tar|tgz|gz|bz2|xz|zst)(?:\.(?:bak|old|backup))?$" - [F,END,NC]
# Reject PHP/source-looking backup suffixes (e.g. config.php.txt, db.php.save).
RewriteRule "(^|/)(?:config(?:\.[^/]*)?|\.env(?:\.[^/]*)?|[^/]+\.php)\.(?:txt|save|backup|bak|old|orig|swp)$" - [F,END,NC]
# Deny common accidental debug and test endpoints, including nested directories.
RewriteRule "(^|/)(?:debug|test-db|db-test|adminer|phpmyadmin|phpinfo|server-status)(?:\.[^/]*)?$" - [F,END,NC]

# Canonical URLs. Legacy PHP entrypoints stay available for integrations and POSTs.
RewriteRule ^dang-xuat/?$ api/logout.php [END,QSA]
RewriteRule ^api/dang-ky/?$ api/register.php [END,QSA]
RewriteRule ^api/email/gui-ma/?$ api/send-email-code.php [END,QSA]
RewriteRule ^api/email/xac-minh/?$ api/verify-email-code.php [END,QSA]
RewriteRule ^api/tai-khoan/ho-so/?$ api/user-profile.php [END,QSA]
RewriteRule ^api/tai-khoan/mat-khau/?$ api/change-password.php [END,QSA]
RewriteRule ^api/tai-khoan/khoi-phuc/?$ api/forgot-password.php [END,QSA]
RewriteRule ^captcha/?$ captcha.php [END,QSA]
RewriteRule ^dang-nhap/?$ login.php [END,QSA]
RewriteRule ^dang-ky/?$ register.php [END,QSA]
RewriteRule ^quen-mat-khau/?$ forgot-password.php [END,QSA]
RewriteRule ^tai-khoan/?$ home.php [END,QSA]
RewriteRule ^tai-khoan/ho-so/?$ profile.php [END,QSA]
RewriteRule ^tai-khoan/nhan-vat/?$ characters.php [END,QSA]
RewriteRule ^bang-xep-hang/?$ rankings.php [END,QSA]
RewriteRule ^nap/?$ topup/index.php [END,QSA]
RewriteRule ^nap/the/?$ topup/card.php [END,QSA]
RewriteRule ^nap/ngan-hang/?$ topup/bank.php [END,QSA]
RewriteRule ^nap/lich-su/?$ topup/history.php [END,QSA]
RewriteRule ^nap/top/?$ topup/top.php [END,QSA]
RewriteRule ^quan-tri/?$ admin/index.php [END,QSA]
RewriteRule ^quan-tri/dang-nhap/?$ admin/login.php [END,QSA]
RewriteRule ^quan-tri/dang-xuat/?$ admin/logout.php [END,QSA]
RewriteRule ^quan-tri/ma-gioi-thieu/?$ admin/referrals.php [END,QSA]
RewriteRule ^quan-tri/nap/?$ topup/admin/index.php [END,QSA]
RewriteRule ^quan-tri/nap/ti-le/?$ topup/admin/rates.php [END,QSA]
RewriteRule ^quan-tri/nap/cong-tai-nguyen/?$ topup/admin/grant.php [END,QSA]
RewriteRule ^quan-tri/nap/doi-soat/?$ topup/admin/orders.php [END,QSA]
RewriteRule ^quan-tri/nap/du-lieu-game/?$ topup/admin/legacy.php [END,QSA]
RewriteRule ^nap-the/?$ topup/card.php [END,QSA]
RewriteRule ^nap-ngan-hang/?$ topup/bank.php [END,QSA]
RewriteRule ^$ index.php [END,QSA]

# Do not expose environment files, credentials, backups, or database dumps.
<FilesMatch "(?i)^(?:\.env(?:\..*)?|\.htaccess|\.htpasswd|config(?:\..*)?\.php|.*\.(?:sql|sqlite|log|ini|bak|old|orig|swp|pem|key|p12|pfx))$">
    Require all denied
</FilesMatch>
<FilesMatch "(?i)^(?:\.gitignore|\.gitattributes|\.gitmodules|README(?:\..*)?|LICENSE(?:\..*)?)$">
    Require all denied
</FilesMatch>
