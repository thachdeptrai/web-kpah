# KPAH web: URL sạch, không liệt kê thư mục và bảo vệ mã backend.
Options -Indexes -MultiViews
DirectoryIndex index.php
RewriteEngine On

# Chỉ chặn các thư mục chứa mã/backend hoặc dữ liệu nội bộ.
# Không chặn thư mục screen/screens, giao diện, assets hoặc các file JS/CSS công khai.
RewriteRule ^(?:includes|storage|vendor|config|core|database|models|controllers|services|repositories|helpers|bootstrap|private)(?:/|$) - [F,END,NC]

# Chặn file cấu hình, môi trường, log, bản sao lưu, dump SQL và khóa bí mật.
<FilesMatch "(?i)^(?:\.env(?:\..*)?|\.htaccess|\.htpasswd|composer\.(?:json|lock)|config(?:\.[a-z0-9_-]+)?\.php|.*\.(?:sql|sqlite|log|ini|bak|old|orig|swp|dist|pem|key|p12|pfx))$">
    Require all denied
</FilesMatch>

# Chặn metadata quản lý mã nguồn và tài liệu nội bộ.
<FilesMatch "(?i)^(?:\.gitignore|\.gitattributes|\.gitmodules|README(?:\..*)?|LICENSE(?:\..*)?)$">
    Require all denied
</FilesMatch>

# Đưa URL cũ có đuôi PHP về URL sạch.
RewriteCond %{THE_REQUEST} \s/+(.*/)?login\.php[?\s] [NC]
RewriteRule ^login\.php$ dang-nhap [R=302,L,NE]
RewriteCond %{THE_REQUEST} \s/+(.*/)?register\.php[?\s] [NC]
RewriteRule ^register\.php$ dang-ky [R=302,L,NE]
RewriteCond %{THE_REQUEST} \s/+(.*/)?home\.php[?\s] [NC]
RewriteRule ^home\.php$ tai-khoan [R=302,L,NE]
RewriteCond %{THE_REQUEST} \s/+(.*/)?forgot-password\.php[?\s] [NC]
RewriteRule ^forgot-password\.php$ quen-mat-khau [R=302,L,NE]

RewriteRule ^(dang-nhap|dang-ky|tai-khoan|quen-mat-khau)/$ $1 [R=302,L]
RewriteRule ^dang-nhap/?$ login.php [END,QSA]
RewriteRule ^dang-ky/?$ register.php [END,QSA]
RewriteRule ^tai-khoan/?$ home.php [END,QSA]
RewriteRule ^quen-mat-khau/?$ forgot-password.php [END,QSA]
RewriteRule ^$ index.php [END]

# File/thư mục công khai (screen/screens, assets, API, ảnh...) vẫn chạy bình thường.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [END]
