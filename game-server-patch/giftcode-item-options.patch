@@ -154,9 +158,49 @@ public class GiftCode {
                 newItem.createOptionCanh(4, 50);
             }
         }
-      
+
+        applyAdminOptions(newItem, optionSpec);
+        newItem.lock = (byte) lock;
+        p.iItems.add(newItem);
+
         newItem.dateCreate = Char.getDayTime(0L);
         p.sendMessage(MessageCreator.createCharInventoryMessage(p, 1));
     }
 
+    private static void applyAdminOptions(Item item, String optionSpec) {
+        if (optionSpec == null || optionSpec.trim().isEmpty()) {
+            return;
+        }
+        String[] options = optionSpec.split(";");
+        boolean[] used = new boolean[141];
+        for (String option : options) {
+            String[] pair = option.split("=", 2);
+            if (pair.length != 2) {
+                throw new IllegalArgumentException("GiftCode option sai dinh dang");
+            }
+            int id = Integer.parseInt(pair[0]);
+            int param = Integer.parseInt(pair[1]);
+            if (id < 0 || id > 140 || used[id] || param < 1) {
+                throw new IllegalArgumentException("GiftCode option khong hop le");
+            }
+            used[id] = true;
+            if (id < 33) {
+                if (param > Short.MAX_VALUE) throw new IllegalArgumentException("Option vuot short");
+                item.atb[id] = (short) param;
+            } else if (id < 43) {
+                if (param > Byte.MAX_VALUE) throw new IllegalArgumentException("Option vuot byte");
+                item.newAtb[id - 33] = (byte) param;
+            } else if (id < 58) {
+                if (param > Byte.MAX_VALUE) throw new IllegalArgumentException("Option vuot byte");
+                item.addMoreLevelSkill[id - 43] = (byte) param;
+            } else if (id < 61) {
+                if (param > Byte.MAX_VALUE) throw new IllegalArgumentException("Option vuot byte");
+                item.lockAtb[id - 58] = (byte) param;
+            } else {
+                if (param > Short.MAX_VALUE) throw new IllegalArgumentException("Option vuot short");
+                item.otherAtt[id - 61] = (short) param;
+            }
+        }
+    }
+
 }
